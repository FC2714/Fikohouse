# Database Configuration
# For development: sqlite:///./fikohouse.db
# For production: postgresql://user:password@hostname:5432/fikohouse
DATABASE_URL=postgresql://user:password@localhost:5432/fikohouse

# Encryption key for storing email app passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Admin credentials
ADMIN_PASSWORD=your-strong-admin-password-here

# Application environment
ENVIRONMENT=production
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8000
